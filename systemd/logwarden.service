[Unit]
Description=logwarden: SSH brute force and suspicious login detection
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/logwarden/venv/bin/logwarden --config /etc/logwarden/config.toml
Restart=on-failure
RestartSec=5
# Needs to read the journal, nothing else.
User=logwarden
Group=systemd-journal
SupplementaryGroups=adm
StateDirectory=logwarden
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
